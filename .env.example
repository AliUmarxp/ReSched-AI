APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./data/resched_ai_app.sqlite3
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deployment
ALLOWED_ORIGINS=http://127.0.0.1:8002,http://localhost:8002
# Enable this only for the single account that should contain bundled sample data.
# If DEMO_USERNAME already exists, DEMO_PASSWORD may stay empty and is never changed.
# To create a new demo account automatically, provide a 10+ character password.
ENABLE_DEMO_ACCOUNT=false
DEMO_USERNAME=demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
